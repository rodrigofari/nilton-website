# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# The site itself needs none of these — it is static and has no build step.
# These are only for operating the Cloudflare account from the command line
# (wiring the custom domain, DNS records, purging cache).

# Scoped API token. Create at:
#   dash.cloudflare.com -> My Profile -> API Tokens -> Create Custom Token
# Minimum permissions for domain setup:
#   Account -> Cloudflare Pages -> Edit
#   Zone    -> DNS              -> Edit
#   Zone    -> Zone Settings    -> Edit
#   Zone    -> Zone             -> Read
#   Zone    -> Cache Purge      -> Purge
# Scope Zone Resources to the single zone. Set a short TTL and revoke when done.
CLOUDFLARE_API_TOKEN=

# Identifiers, not secrets — visible in any dashboard URL.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=madeirasurfcoach.com
CLOUDFLARE_PAGES_PROJECT=nilton-website
