# Cloudflare Pages _headers
# Strict CSP from day one. No inline scripts, no inline styles.
# X-Robots-Tag layered noindex on /styleguide.html (defense in depth with meta tag).
# Long cache on hashable assets, short cache on HTML.

# ⚠️ ================= SOFT-LAUNCH GATE ================= ⚠️
# The `X-Robots-Tag: noindex, nofollow` line in the /* block below is TEMPORARY.
# Delete that ONE line before public launch. Nothing else in this file changes.
#
# Why it's here: the site still ships placeholder content — ~105 picsum photos,
# 3 "Sample Reviewer" testimonials per locale, ~75 data-placeholder blocks.
# Letting Google index that burns the domain's first impression on stock imagery
# and fake reviews, and that outlasts the fix. This keeps madeirasurfcoach.com
# live and shareable with the client while staying out of search results.
#
# robots.txt deliberately still says `Allow: /` — a crawler must be able to
# FETCH the page in order to SEE this noindex. Blocking in robots.txt instead
# would be strictly worse: it can produce an indexed URL with no content.
#
# Removal gate — all four must hold before deleting the line:
#   [ ] grep -rn 'picsum.photos'    --include='*.html' .  -> 0
#   [ ] grep -rn 'data-placeholder' --include='*.html' .  -> 0
#   [ ] Real GA4 ID in scripts/config.js (not G-XXXXXXXXXX)
#   [ ] Real testimonials + real legal entity name (footer + privacy)
# Then: delete the line, redeploy, submit sitemap.xml in Search Console.
# ⚠️ ==================================================== ⚠️

# ---------- Global security headers (all paths) ----------
# NOTE: exactly one `/*` block. Don't add a second one — rule merging across
# duplicate path patterns is not guaranteed, and a second block silently
# shadowing the CSP/HSTS here would be a bad day.
#
# CSP + GA4: connect-src/img-src use `*.google-analytics.com`, NOT the exact
# host `www.google-analytics.com`. GA4 routes EU visitors to
# `region1.google-analytics.com` — a different host, and one that
# `*.analytics.google.com` does NOT match (google-analytics.com and
# analytics.google.com are separate domains). With the exact host only, every
# hit from PT/FR/DE/UA — i.e. essentially this site's whole audience — is
# blocked by CSP and GA4 silently records nothing.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net; img-src 'self' data: https://images.unsplash.com https://picsum.photos https://fastly.picsum.photos https://*.google-analytics.com; style-src 'self'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ---------- Internal: styleguide noindex (layered) ----------
# Redundant while the soft-launch gate above is active; it is the permanent
# rule that must survive once that gate is removed.
/styleguide.html
  X-Robots-Tag: noindex, nofollow

# ---------- Cache: HTML (short, must-revalidate) ----------
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate

# ---------- Cache strategy ----------
# CSS and JS use STABLE filenames (no content-hash versioning). Treating them as
# `immutable` is a footgun: a deploy that changes contents without changing the
# URL never propagates to browsers that cached the old version. So CSS/JS gets
# a short max-age + must-revalidate — Cloudflare's etag handles the rest
# (304 Not Modified when content is unchanged).
#
# Fonts and images use stable-content filenames (logo-256.png, etc.) and don't
# change in place — they get the long immutable cache safely.

/styles/*
  Cache-Control: public, max-age=3600, must-revalidate

/scripts/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# ---------- JSON content (short — same as HTML) ----------
/content/*
  Cache-Control: public, max-age=300, must-revalidate
