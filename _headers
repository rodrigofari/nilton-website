# Cloudflare Pages _headers
# Strict CSP from day one. No inline scripts, no inline styles.
# X-Robots-Tag layered noindex on /styleguide.html (defense in depth with meta tag).
# Long cache on hashable assets, short cache on HTML.

# ---------- Global security headers (all paths) ----------
# NOTE: exactly one `/*` block. Don't add a second one — rule merging across
# duplicate path patterns is not guaranteed, and a second block silently
# shadowing the CSP/HSTS here would be a bad day.
#
# Two analytics tools run side by side on purpose, measuring different things.
# GA4 (googletagmanager + google-analytics) is consent-gated and reports what
# visitors DO. Cloudflare Web Analytics (cloudflareinsights) is cookieless,
# needs no consent, and reports how many visitors there ACTUALLY ARE — the
# denominator GA4 can never see, because it only counts people who accept.
# Cloudflare injects its beacon at the edge; without these two entries the
# browser refuses to run it and the dashboard reads near-zero while looking
# installed. Verified in a real browser before and after.
#
# CSP + GA4: connect-src/img-src use `*.google-analytics.com`, NOT the exact
# host `www.google-analytics.com`. GA4 routes EU visitors to
# `region1.google-analytics.com` — a different host, and one that
# `*.analytics.google.com` does NOT match (google-analytics.com and
# analytics.google.com are separate domains). With the exact host only, every
# hit from PT/FR/DE/UA — i.e. essentially this site's whole audience — is
# blocked by CSP and GA4 silently records nothing.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net; img-src 'self' data: https://images.unsplash.com https://*.google-analytics.com; style-src 'self'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ---------- Internal: styleguide noindex (layered) ----------
#
# BOTH paths are listed on purpose. Pages normalises /styleguide.html to
# /styleguide with a 308, so the .html rule alone would stop covering the URL
# visitors and crawlers actually land on the moment the /* gate is removed.
# The page also carries <meta name="robots" content="noindex, nofollow"> as a
# second layer, but the header should not silently disappear.
/styleguide.html
  X-Robots-Tag: noindex, nofollow

/styleguide
  X-Robots-Tag: noindex, nofollow

# ---------- Cache: HTML (short, must-revalidate) ----------
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate

# ---------- Cache strategy ----------
# CSS and JS use STABLE filenames (no content-hash versioning). Treating them as
# `immutable` is a footgun: a deploy that changes contents without changing the
# URL never propagates to browsers that cached the old version. So CSS/JS gets
# a short max-age + must-revalidate — Cloudflare's etag handles the rest
# (304 Not Modified when content is unchanged).
#
# Fonts and images use stable-content filenames (logo-256.png, etc.) and don't
# change in place — they get the long immutable cache safely.

/styles/*
  Cache-Control: public, max-age=3600, must-revalidate

/scripts/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# ---------- JSON content (short — same as HTML) ----------
/content/*
  Cache-Control: public, max-age=300, must-revalidate
